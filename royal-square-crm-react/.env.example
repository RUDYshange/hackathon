# API Base URL — the frontend talks only to the Django API, which owns the
# Neon PostgreSQL connection. The database is never accessed from the browser.
VITE_API_BASE_URL=/api

# Application Metadata
VITE_APP_TITLE=Royal Square Wealth CRM
VITE_APP_VERSION=1.0.0

# Gemini Live Speech-to-Text Configuration
VITE_GEMINI_API_KEY=
VITE_GEMINI_LIVE_MODEL=gemini-3.5-transcribe-live

# Security Flags
VITE_ENABLE_POPIA_MASKING=true
VITE_ENABLE_HONEYPOT=true
VITE_ENABLE_IDEMPOTENCY_LOCK=true

# Google Maps Platform Key (Accident Location Pinning)
VITE_GOOGLE_MAPS_API_KEY=
