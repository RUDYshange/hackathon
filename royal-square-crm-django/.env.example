# Core Django Security Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_RUNSERVER_HOST=127.0.0.1
DJANGO_RUNSERVER_PORT=8000

# Supabase PostgreSQL Database — the only database (no local SQLite).
# Copy the connection string from Supabase Dashboard > Connect (JDBC form works
# as-is; the 'jdbc:' prefix is stripped automatically) and set the pooler user
# and password.
DB_URL=jdbc:postgresql://aws-1-eu-west-1.pooler.supabase.com:5432/postgres
DB_USER=your-supabase-database-user
DB_PASSWORD=your-supabase-database-password
DB_SSLMODE=require

# Supabase project metadata. These are available to backend integrations.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=

# Gemini Live Speech-to-Text & AI Services
GEMINI_API_KEY=

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hardened HTTP Headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
