# Core Django Security Settings
DJANGO_SECRET_KEY=your-secure-random-secret-key-here
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_RUNSERVER_HOST=127.0.0.1
DJANGO_RUNSERVER_PORT=8000

# Neon PostgreSQL Database — the only database (no local SQLite).
# Copy the full connection string from the Neon Console > Connect and paste it
# into DATABASE_URL. Use the pooled endpoint (host contains "-pooler") for the
# running app. Neon requires TLS; sslmode=require is enforced automatically.
# Format:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<db>?sslmode=require&channel_binding=require
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DB_SSLMODE=require
DB_CONN_MAX_AGE=600

# Gemini Live Speech-to-Text & AI Services
GEMINI_API_KEY=

# Voice Assistant (Groq) — server-side only, never exposed to the browser.
# One key powers both speech-to-text (Whisper) and the agent brain (Llama 3.3
# 70B) for the multilingual voice chatbot. Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3
GROQ_AGENT_MODEL=openai/gpt-oss-120b
# Allow the assistant to perform write actions. Set to False for read-only.
ASSISTANT_ENABLE_WRITE_ACTIONS=True

# Cross-Origin Resource Sharing (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hardened HTTP Headers
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True
X_FRAME_OPTIONS=DENY
SESSION_COOKIE_HTTPONLY=True
CSRF_COOKIE_HTTPONLY=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
